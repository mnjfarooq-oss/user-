#include <stdio.h>

int main()
{
    int pin = 1234, entered_pin;
    int balance = 5000, choice, amount;

    printf("Enter ATM PIN: ");
    scanf("%d", &entered_pin);

    if (entered_pin == pin)
    {
        printf("\n1. Check Balance");
        printf("\n2. Withdraw Money");
        printf("\n3. Deposit Money");
        printf("\n4. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Balance = Rs.%d", balance);
                break;

            case 2:
                printf("Enter amount: ");
                scanf("%d", &amount);

                if(amount <= balance && amount > 0)
                {
                    balance -= amount;
                    printf("Withdrawal Successful!");
                    printf("\nRemaining Balance = Rs.%d", balance);
                }
                else
                    printf("Insufficient Balance or Invalid Amount");
                break;

            case 3:
                printf("Enter amount: ");
                scanf("%d", &amount);

                if(amount > 0)
                {
                    balance += amount;
                    printf("Deposit Successful!");
                    printf("\nNew Balance = Rs.%d", balance);
                }
                else
                    printf("Invalid Amount");
                break;

            case 4:
                printf("Thank You!");
                break;

            default:
                printf("Invalid Choice");
        }
    }
    else
    {
        printf("Incorrect PIN!");
    }

    return 0;
}